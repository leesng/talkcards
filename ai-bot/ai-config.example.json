// ai-config.example.json —— 复制为 ai-config.json 后按需修改。
// 所有字段均可被环境变量覆盖：
//   TALKCARDS_WS_URL / OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL / TALKCARDS_BOT_NAME
{
  "server": {
    "url": "ws://127.0.0.1:8000/ws"
  },
  "llm": {
    "baseUrl": "https://api.openai.com/v1",
    "apiKey": "",
    "model": "gpt-4o-mini",
    "timeoutMs": 30000,
    "temperature": 0.2,
    "jsonMode": true
  },
  "bot": {
    "name": "AI阿花",
    "join": { "mode": "fixed", "deskId": 1, "posId": 3 },
    "autoPrepare": true,
    "host": { "autoStart": true, "fillBots": false },
    "chat": { "onOwnTurn": true, "onOthersTurn": false, "minIntervalMs": 5000 },
    "decideTimeoutMs": 30000,
    "reconnect": { "enabled": true, "maxDelayMs": 10000 },
    "keepPlaying": true,
    "verbose": false
  }
}